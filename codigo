
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0b0b">
<title>Javier Peñúñuri | Specialty Coffee</title>

<style>
:root {
  --bg: #0b0b0b;
  --white: #f2f0eb;
  --muted: #99958d;
  --coffee: #a77b55;
  --line: #292723;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: Helvetica, Arial, sans-serif;
  font-weight: 400;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

img, video {
  display: block;
  width: 100%;
}

/* NAVIGATION */

nav {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 20px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(11,11,11,.88);
  backdrop-filter: blur(12px);
  z-index: 10;
  border-bottom: 1px solid var(--line);
}

.logo {
  font-size: 13px;
  letter-spacing: 3px;
  font-weight: 700;
}

.nav-links {
  display: flex;
  gap: 28px;
}

.nav-links a {
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--muted);
  transition: color .3s;
}

.nav-links a:hover {
  color: var(--white);
}

/* GENERAL */

.container {
  width: 86%;
  max-width: 1100px;
  margin: auto;
}

section {
  padding: 120px 0;
  border-bottom: 1px solid var(--line);
}

.eyebrow {
  color: var(--coffee);
  font-size: 10px;
  letter-spacing: 4px;
  margin-bottom: 20px;
  text-transform: uppercase;
}

h2 {
  font-size: clamp(30px, 5vw, 48px);
  font-weight: 400;
  letter-spacing: -2px;
  line-height: 1.1;
  margin-bottom: 35px;
}

p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
}

/* ANIMATIONS */

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity .8s ease, transform .8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(25px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* HERO */

.hero {
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding-top: 100px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 0.8fr;
  gap: 70px;
  align-items: center;
}

.hero h1 {
  font-size: clamp(45px, 7vw, 85px);
  line-height: .95;
  letter-spacing: -5px;
  font-weight: 700;
  margin-bottom: 25px;
  animation: appear 1s ease both;
}

.hero h1 span {
  color: var(--coffee);
}

.hero-description {
  max-width: 430px;
  margin-bottom: 35px;
  animation: appear 1s .2s ease both;
}

.hero-image {
  height: 470px;
  object-fit: cover;
  filter: grayscale(15%);
  animation: appear 1s .3s ease both;
}

.button {
  display: inline-block;
  border: 1px solid var(--coffee);
  padding: 13px 25px;
  font-size: 10px;
  letter-spacing: 2px;
  transition: background .3s, color .3s;
}

.button:hover {
  background: var(--coffee);
  color: #000;
}

/* PROFILE */

.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
}

.profile-grid p {
  max-width: 500px;
}

/* VIDEO */

.video-wrapper {
  width: 100%;
  max-width: 850px;
  margin: 0 auto;
  background: #151515;
  overflow: hidden;
}

.video-wrapper video {
  max-height: 600px;
  object-fit: cover;
}

.video-caption {
  display: flex;
  justify-content: space-between;
  margin-top: 18px;
  gap: 20px;
}

/* SKILLS */

.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}

.skill {
  background: var(--bg);
  padding: 35px 25px;
  transition: background .3s;
}

.skill:hover {
  background: #171411;
}

.skill h3 {
  font-size: 15px;
  margin-bottom: 12px;
  font-weight: 500;
}

/* EXPERIENCE */

.experience {
  border-top: 1px solid var(--line);
}

.job {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  padding: 30px 0;
  border-bottom: 1px solid var(--line);
}

.job h3 {
  font-size: 17px;
  font-weight: 500;
  margin-bottom: 5px;
}

.job-date {
  color: var(--coffee);
  font-size: 11px;
  letter-spacing: 1px;
  white-space: nowrap;
}

/* GALLERY */

.gallery {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.gallery img {
  height: 350px;
  object-fit: cover;
  filter: grayscale(20%);
  transition: filter .5s, transform .5s;
}

.gallery img:hover {
  filter: grayscale(0%);
  transform: scale(1.015);
}

/* CONTACT */

.contact {
  text-align: center;
}

.contact h2 {
  margin-bottom: 20px;
}

.contact-info {
  margin-top: 35px;
}

.contact-info p {
  margin: 8px 0;
}

footer {
  padding: 30px 7%;
  text-align: center;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 2px;
}

/* MOBILE */

@media (max-width: 700px) {
  nav {
    padding: 18px 6%;
  }

  .nav-links {
    gap: 12px;
  }

  .nav-links a {
    font-size: 8px;
    letter-spacing: 1px;
  }

  .hero-grid,
  .profile-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .hero {
    padding-top: 130px;
  }

  .hero h1 {
    letter-spacing: -3px;
  }

  .hero-image {
    height: 420px;
  }

  section {
    padding: 85px 0;
  }

  .skills-grid {
    grid-template-columns: 1fr 1fr;
  }

  .gallery img {
    height: 230px;
  }

  .job {
    flex-direction: column;
    gap: 8px;
  }

  .video-caption {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition: none !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
</style>
</head>

<body>

